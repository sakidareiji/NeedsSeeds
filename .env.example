# ---- Supabase ----
# Local dev (supabase start) prints these values. Paste them here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY. Never expose to the client. Used by the
# analysis pipeline (M2) and admin operations (M4) that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- LLM(F3 AI解析)----
# 使用プロバイダ: "gemini" または "anthropic"。未指定なら設定済みのキーから
# 自動選択(両方あれば gemini を優先)。
LLM_PROVIDER=gemini

# Gemini(既定)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Anthropic(切り替え用に実装は残している)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google OAuth ボタンを表示するか。Supabase 側で Google プロバイダを有効化した
# ときだけ "true" にする(未設定のまま押すと "Unsupported provider" エラーになる)。
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Shared secret required to invoke the internal analysis worker endpoint (M2).
ANALYSIS_WORKER_SECRET=change-me
# Set this to the SAME value as ANALYSIS_WORKER_SECRET so Vercel Cron's
# `Authorization: Bearer` is accepted by /api/analyze in production.
CRON_SECRET=change-me

# ---- メール送信(解決ヒント通知などのトランザクションメール) ----
# 未設定時: 開発環境では Supabase ローカルの Mailpit(127.0.0.1:54325)へ送信、
# 本番では送信をスキップする(本番公開時に SMTP を設定すること)。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Needs Seeds <noreply@example.com>"
