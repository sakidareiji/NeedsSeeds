# ---- Supabase ----
# Local dev (supabase start) prints these values. Paste them here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY. Never expose to the client. Used by the
# analysis pipeline (M2) and admin operations (M4) that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Anthropic (M2) ----
ANTHROPIC_API_KEY=
# Model id used by the analysis pipeline. Overridable without code changes.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret required to invoke the internal analysis worker endpoint (M2).
ANALYSIS_WORKER_SECRET=change-me
